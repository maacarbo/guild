{
  "name": "guild",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @guild/orchestrator smoke",
    "deps:check": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "smoke:m2a": "pnpm --filter @guild/orchestrator smoke:m2a"
  },
  "devDependencies": {
    "dependency-cruiser": "18.1.0"
  }
}
