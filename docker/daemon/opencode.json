{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM gateway",
      "options": {
        "baseURL": "http://litellm:4000/v1",
        "apiKey": "{env:GUILD_DAEMON_VIRTUAL_KEY}"
      },
      "models": {
        "claude-sonnet-5": { "name": "Claude Sonnet 5 (gateway, Anthropic direct)" },
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5 (gateway, Anthropic direct)" },
        "or-claude-sonnet-5": { "name": "Claude Sonnet 5 (gateway, OpenRouter)" },
        "or-claude-haiku-4-5": { "name": "Claude Haiku 4.5 (gateway, OpenRouter)" }
      }
    }
  }
}
