# Guild Tier 1 compose stack — copy to .env and fill in.
# NAMES ONLY live in git; never commit .env. Groupings below mirror the
# normative secret names in deploy/README.md (multica-app / litellm-app /
# guild-daemon / guild-conductor) so Tier 2 Kubernetes Secrets map 1:1.

# ---- Version pins (lockstep pair with docker/daemon — bump together) ------
# Third-party version pins live in versions.env (#14) — do not set them here:
# a value in .env would silently shadow the mirrored compose defaults.

# ---- Ports (all bound to 127.0.0.1) ---------------------------------------
MULTICA_BACKEND_PORT=8080
MULTICA_FRONTEND_PORT=3000
LITELLM_PORT=4000

# ---- multica-app -----------------------------------------------------------
# openssl rand -hex 32
MULTICA_JWT_SECRET=
# openssl rand -hex 16
MULTICA_POSTGRES_PASSWORD=
# VCS-integration at-rest encryption key: openssl rand -hex 32
MULTICA_VCS_SECRET_KEY=
# Dev login: APP_ENV=development + a fixed 6-digit code makes first-user
# creation scriptable (you must still call /auth/send-code first — the fixed
# code only short-circuits the comparison). NEVER set the code on anything
# reachable beyond 127.0.0.1. Leave it empty to log-scrape codes instead.
MULTICA_APP_ENV=development
MULTICA_DEV_VERIFICATION_CODE=
MULTICA_ALLOW_SIGNUP=true

# ---- litellm-app -----------------------------------------------------------
# Master key for the gateway admin API (mints virtual keys): sk-... (any string)
LITELLM_MASTER_KEY=
# Encrypts provider keys at rest: openssl rand -hex 32
LITELLM_SALT_KEY=
# openssl rand -hex 16
LITELLM_POSTGRES_PASSWORD=
# Provider keys — the ONLY place they appear in the stack; agents get virtual
# keys. OPENROUTER_API_KEY is the recommended default (D9): one key reaches
# Claude AND the cheap testing tier (or-deepseek-v3-2, or-gemini-flash-lite).
# ANTHROPIC_API_KEY is optional — direct Anthropic route only.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ---- guild-daemon ----------------------------------------------------------
# Multica personal access token (mul_...) for the daemon — mint via the
# bootstrap flow or the web UI after the control plane is up.
MULTICA_DAEMON_TOKEN=
# LiteLLM virtual key the daemon's agent CLIs authenticate with (sk-...).
# Read by OpenCode's baked litellm provider config
# ({env:GUILD_DAEMON_VIRTUAL_KEY} in docker/daemon/opencode.json).
GUILD_DAEMON_VIRTUAL_KEY=
# GitHub PAT scoped to the scratch/target repo(s) only — HTTPS git auth.
GUILD_DAEMON_GITHUB_TOKEN=
GUILD_DAEMON_GIT_NAME=guild-daemon
GUILD_DAEMON_GIT_EMAIL=guild-daemon@localhost
# Labels this daemon's runtime rows ("<provider> (<device_name>)").
# Daemon identity is a per-container UUID in ~/.multica/daemon.id, minted
# fresh per container (no volume), so multiple daemons never collide.
MULTICA_DAEMON_DEVICE_NAME=guild-daemon-1

# ---- guild-conductor (M1b+; unused by M1a probes) --------------------------
# openssl rand -hex 16
GUILD_POSTGRES_PASSWORD=
# --- conductor service (M2b, profile: conductor) ---
# guild-init prints the three values below (docker compose run --rm guild-init):
# the conductor member's PAT, the workspace id, and the role→agent JSON.
GUILD_MULTICA_TOKEN=
GUILD_WORKSPACE_ID=
GUILD_ROLE_AGENTS=
# M3 hiring: model route runtime-hired agents bind to (cheap tier by default)
GUILD_AGENT_MODEL=litellm/or-deepseek-v3-2
# Contract-validation sandbox image (D6 amendment 2026-08-16): pinned minimal
# Node image, credential-free by construction; override per install if needed
# GUILD_VALIDATOR_IMAGE=node:22-alpine
# Product repository over HTTPS with the scoped git PAT embedded:
# https://x-access-token:<PAT>@github.com/you/your-product.git
GUILD_REPO_URL=
GUILD_TARGET_BRANCH=main
# Plan budget (integer cents) when an idea names no `budget:` directive.
GUILD_PLAN_BUDGET_CENTS=300
# Project watchdog ceiling — set BOTH or NEITHER (cents). Hard cap cancels
# in-flight work and locks dispatch; raise-and-restart is the only unlock.
GUILD_PROJECT_SOFT_CAP_CENTS=
GUILD_PROJECT_HARD_CAP_CENTS=
# The operator's own PAT — only guild-demo uses it (ideas are operator-authored).
GUILD_OPERATOR_TOKEN=

# --- D15 operator allowlist (guild-init prints both; conductor section) ---
# The only member ids the conductor attributes as "operator". guild init prints
# it; the conductor refuses to start if it is empty, contains its own id, or
# contains GUILD_DAEMON_MEMBER_ID (the #17 A5d guard).
GUILD_OPERATOR_MEMBER_IDS=
# The daemon's own member id (daemon@guild.local). Asserted OFF the allowlist at
# conductor startup and by guild doctor [5/7].
GUILD_DAEMON_MEMBER_ID=

# Per-project git credential by NAME-indirection (D17, optional): the NAME of a
# daemon-env variable holding this project's repo-scoped token. The value goes
# into the daemon service env via a compose override, never here.
# GUILD_GIT_CRED_NAME=GUILD_GIT_TOKEN_MYPROJ
# ... optionally pinned to one request host (#56) — other hosts use the ambient PAT:
# GUILD_GIT_CRED_HOST=github.com
