# One versions file (#14, M1 standing rule): every pinned third-party version
# the compose stack consumes, in one place. The compose interpolation defaults
# and the daemon-image ARG defaults MIRROR these values — a unit test
# (packages/orchestrator/src/adapters/versions-file.test.ts, CI-enforced)
# fails the build on any disagreement, so README, compose, and image can
# never silently drift.
#
# Bumps are deliberate (CLAUDE.md pin discipline): the Multica release
# watcher (.github/workflows/multica-release-watcher.yml) opens a PR with the
# LICENSE diff for the human gate — nothing here ever auto-merges. LiteLLM
# and CLI pins move only by hand (D2/D3).
MULTICA_VERSION=v0.4.15
OPENCODE_VERSION=1.18.10
LITELLM_IMAGE_DIGEST=sha256:528774743b9efc02ee4612e99a79810df91188689ff4e569d9bcc79216b1e906
SOCKET_PROXY_IMAGE_DIGEST=sha256:9e4b9e7517a6b660f2cc903a19b257b1852d5b3344794e3ea334ff00ae677ac2
